{
    "name": "sinporg/app",
    "description": "SINPORG - sistema de gestao da producao organica (legado PHP + fundacao modular)",
    "type": "project",
    "require": {
        "mpdf/mpdf": "^8.2",
        "phpoffice/phpspreadsheet": "^5.2",
        "tecnickcom/tcpdf": "^6.10",
        "dompdf/dompdf": "^3.1",
        "resend/resend-php": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0",
        "qossmic/deptrac": "^2.0",
        "phpcsstandards/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "deptrac": "deptrac analyse --no-progress",
        "lint": "phpcs"
    },
    "config": {
        "sort-packages": true
    }
}
