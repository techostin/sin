# Diretorio interno da aplicacao: nunca deve ser servido pela web.
# Os arquivos daqui sao carregados via require/include no servidor.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (fallback)
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
