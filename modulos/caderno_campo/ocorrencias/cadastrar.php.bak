<?php
$page_title = "Cadastrar Ocorrência";
require_once __DIR__ . '/../../../includes/header.php';
require_once __DIR__ . '/../../../includes/menu.php';
require_once __DIR__ . '/../../../classes/Ocorrencia.php';
require_once __DIR__ . '/../../../classes/Propriedade.php';
require_once __DIR__ . '/../../../classes/Lavoura.php';
require_once __DIR__ . '/../../../classes/Insumo.php';
require_once __DIR__ . '/../../../classes/CSRFProtection.php';

$message = '';
$message_type = '';

// Apenas usuários logados podem acessar
if (!$user->isLoggedIn()) {
    echo "<div class='alert alert-danger'>Você não tem permissão para acessar esta página.</div>";
    require_once __DIR__ . '/../../../includes/footer.php';
    exit;
}

// Buscar dados para os selects
$propriedades = [];
$lavouras = [];
$insumos = [];
try {
    $propriedade_obj = new Propriedade();
    $lavoura_obj = new Lavoura();
    $insumo_obj = new Insumo();
    
    $associado_id = $user->getAssociadoId();
    if (!$associado_id) $associado_id = -1;
    
    if ($user->hasPermission(NIVEL_GESTOR)) {
        $propriedades = $propriedade_obj->getAll();
        $insumos = $insumo_obj->getAll();
        // Buscar todas as lavouras
        $db = Database::getInstance()->getConnection();
        $stmt = $db->prepare("SELECT id, nome FROM lavouras ORDER BY nome ASC");
        $stmt->execute();
        $lavouras = $stmt->fetchAll(PDO::FETCH_ASSOC);
    } else {
        $propriedades = $propriedade_obj->getByAssociadoId($associado_id);
        $insumos = $insumo_obj->getByAssociadoId($associado_id);
        // Buscar lavouras do associado
        $db = Database::getInstance()->getConnection();
        $stmt = $db->prepare("SELECT l.id, l.nome FROM lavouras l INNER JOIN propriedades p ON l.propriedade_id = p.id WHERE p.associado_id = ? ORDER BY l.nome ASC");
        $stmt->execute([$associado_id]);
        $lavouras = $stmt->fetchAll(PDO::FETCH_ASSOC);
    }
} catch (PDOException $e) {
    // Tratar erro
}

if ($_SERVER['REQUEST_METHOD'] == 'POST') {
    if (!CSRFProtection::validatePostRequest()) {
        $message = 'Requisição inválida. Por favor, tente novamente.';
        $message_type = 'danger';
    } else {
        $ocorrencia = new Ocorrencia();
        
        // Preparar dados
        $dados = $_POST;
        $dados['associado_id'] = $user->getAssociadoId();
        if (!$dados['associado_id']) $dados['associado_id'] = -1;
        
        // Processar upload da foto
    $foto_url = '';
    if (isset($_FILES['foto']) && $_FILES['foto']['error'] === UPLOAD_ERR_OK) {
        $upload_dir = __DIR__ . '/../../../../uploads/ocorrencias/';
        if (!file_exists($upload_dir)) {
            mkdir($upload_dir, 0777, true);
        }
        
        $file_extension = pathinfo($_FILES['foto']['name'], PATHINFO_EXTENSION);
        $file_name = uniqid('ocorrencia_') . '.' . $file_extension;
        $target_path = $upload_dir . $file_name;
        
        if (move_uploaded_file($_FILES['foto']['tmp_name'], $target_path)) {
            $foto_url = 'uploads/ocorrencias/' . $file_name;
        }
    }
    $dados['foto_url'] = $foto_url;
    
    // Chamar create
    $resultado = $ocorrencia->create($dados);
    
    if ($resultado) {
        $message = "Ocorrência cadastrada com sucesso!";
        $message_type = "success";
    } else {
        $message = "Erro ao cadastrar ocorrência.";
        $message_type = "danger";
    }
    }
}
?>

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h1>Cadastrar Nova Ocorrência</h1>
    <a href="<?php echo SITE_URL; ?>/caderno-campo/ocorrencias" class="btn btn-secondary">Voltar para Lista</a>
</div>

<?php if ($message): ?>
<div class="alert alert-<?php echo $message_type; ?>">
    <?php echo $message; ?>
</div>
<?php endif; ?>

<div class="card">
    <div class="card-body">
        <form id="form-ocorrencia" action="<?php echo SITE_URL; ?>/caderno-campo/ocorrencia/novo" method="POST" enctype="multipart/form-data" class="row g-3">
            <?php echo CSRFProtection::getTokenField(); ?>
            
            <div class="col-md-6">
                <label for="propriedade_id" class="form-label">Propriedade *</label>
                <select class="form-select" id="propriedade_id" name="propriedade_id" required>
                    <option value="">Selecione uma Propriedade</option>
                    <?php foreach ($propriedades as $prop): ?>
                        <option value="<?php echo htmlspecialchars($prop['id']); ?>"><?php echo htmlspecialchars($prop['propriedade']); ?></option>
                    <?php endforeach; ?>
                </select>
            </div>
            
            <div class="col-md-6">
                <label for="lavoura_id" class="form-label">Lavoura</label>
                <select class="form-select" id="lavoura_id" name="lavoura_id">
                    <option value="">Selecione uma Lavoura (opcional)</option>
                    <?php foreach ($lavouras as $lav): ?>
                        <option value="<?php echo htmlspecialchars($lav['id']); ?>"><?php echo htmlspecialchars($lav['nome']); ?></option>
                    <?php endforeach; ?>
                </select>
            </div>
            
            <div class="col-md-4">
                <label for="tipo" class="form-label">Tipo *</label>
                <select class="form-select" id="tipo" name="tipo" required>
                    <option value="">Selecione o Tipo</option>
                    <option value="Praga">Praga</option>
                    <option value="Doença">Doença</option>
                    <option value="Fisiológica/Nutricional">Fisiológica/Nutricional</option>
                    <option value="Climatológica">Climatológica</option>
                    <option value="Outro">Outro</option>
                </select>
            </div>
            
            <div class="col-md-8">
                <label for="nome_comum" class="form-label">Nome Comum *</label>
                <input type="text" class="form-control" id="nome_comum" name="nome_comum" required placeholder="Ex: Lagarta do Cartucho">
            </div>
            
            <div class="col-md-4">
                <label for="data_deteccao" class="form-label">Data de Detecção *</label>
                <input type="date" class="form-control" id="data_deteccao" name="data_deteccao" required>
            </div>
            
            <div class="col-md-4">
                <label for="severidade" class="form-label">Severidade *</label>
                <select class="form-select" id="severidade" name="severidade" required>
                    <option value="Baixa">Baixa</option>
                    <option value="Média">Média</option>
                    <option value="Alta">Alta</option>
                </select>
            </div>
            
            <div class="col-md-12">
                <label for="descricao" class="form-label">Descrição</label>
                <textarea class="form-control" id="descricao" name="descricao" rows="3" placeholder="Descreva a ocorrência..."></textarea>
            </div>
            
            <div class="col-md-12">
                <label for="acao_manejo" class="form-label">Ação de Manejo Adotada</label>
                <textarea class="form-control" id="acao_manejo" name="acao_manejo" rows="3" placeholder="Descreva a ação de manejo..."></textarea>
            </div>
            
            <div class="col-md-6">
                <label for="insumo_utilizado_id" class="form-label">Insumo Utilizado</label>
                <select class="form-select" id="insumo_utilizado_id" name="insumo_utilizado_id">
                    <option value="">Selecione um Insumo (opcional)</option>
                    <?php foreach ($insumos as $ins): ?>
                        <option value="<?php echo htmlspecialchars($ins['id']); ?>"><?php echo htmlspecialchars($ins['nome']); ?></option>
                    <?php endforeach; ?>
                </select>
            </div>
            
            <div class="col-md-6">
                <label for="foto" class="form-label">Foto de Evidência</label>
                <input type="file" class="form-control" id="foto" name="foto" accept="image/*">
                <div class="form-text">Aceita apenas imagens (JPG, PNG, GIF, etc.)</div>
            </div>
            
            <div class="col-12 mt-4">
                <button type="submit" class="btn btn-primary">Salvar Ocorrência</button>
                <a href="<?php echo SITE_URL; ?>/caderno-campo/ocorrencias" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<?php
require_once __DIR__ . '/../../../includes/footer.php';
?>
